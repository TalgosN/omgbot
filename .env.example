STEAMTRACKER_GOOGLE_SERVICE_ACCOUNT_FILE=key/omgbot-430116-e9a4d9c69b7f.json
# Устарело и игнорируется: Google больше не управляет каталогом.
STEAMTRACKER_CATALOG_SYNC_ENABLED=false
# Выгрузка отчётных листов: Игры, Current_State, Steam Динамика и настройки.
STEAMTRACKER_GOOGLE_EXPORT_ENABLED=false
# Серверный предохранитель. День, время и включение задаются в боте.
STEAMTRACKER_WEEKLY_PROMO_ENABLED=false

# fake работает без ключа. Для настоящей генерации: openrouter.
STEAMTRACKER_GENERATOR=fake
OPENROUTER_API_KEY=
# Можно оставить пустым и использовать модель OpenRouter по умолчанию.
OPENROUTER_MODEL=

# Telegram-согласование выключено до настройки allowlist.
